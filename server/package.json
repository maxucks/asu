{
  "name": "@asu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --cwd .. --hot --env-file server/.env server/src/index.ts",
    "start": "bun run src/index.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "bun run src/db/push_schema.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:setup": "bun run db:push && bun run db:seed"
  },
  "dependencies": {
    "@asu/contracts": "file:../packages/contracts",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
