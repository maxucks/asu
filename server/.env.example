DATABASE_URL=./data/asu.sqlite
# If 3001 is taken, use another port and set NEXT_PUBLIC_ASU_API_URL on the web client to match.
PORT=3001
# Local dev: 127.0.0.1. Docker / VPS: 0.0.0.0
HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API (Docker: set to your public app URL).
# CORS_ORIGINS=http://203.0.113.10:3000
LOG_LEVEL=debug
# Minutes per learning cycle (exp lock per word after review; freeze resets each cycle).
LEARNING_CYCLE_MINUTES=240
